# ─────────────────────────────────────────────────────────────
# KOVAI — environment configuration
# Copy to .env.local.  Never commit real keys.
#
# The filename matters: Next.js reads ".env.local" exactly. A name like
# ".env. local." is silently ignored, and everything in it with it.
# ─────────────────────────────────────────────────────────────

# ── Online intelligence (chat / vision / reasoning) ──────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=KOVAI

# ── Image generation (primary) ───────────────────────────────
# Higgsfield issues a key id and a secret, usually shown as "id:secret".
HF_API_KEY_ID=
HF_API_KEY_SECRET=
HF_API_BASE=https://platform.higgsfield.ai

# ── Image / video generation (secondary) ─────────────────────
KIE_API_KEY=
KIE_API_BASE=https://api.kie.ai

# ── Local runtime ────────────────────────────────────────────
# The FastAPI process started by `npm run dev`.
NEXT_PUBLIC_LOCAL_RUNTIME_URL=http://127.0.0.1:8756
OLLAMA_HOST=http://127.0.0.1:11434

# Where GGUF weights live. Defaults to ./models — drop a .gguf in there and it
# runs directly, with no import step.
KOVAI_GGUF_DIR=

# The local model the router prefers when you have not chosen one. Leave empty
# and the first runnable file in the models folder is used.
KOVAI_DEFAULT_MODEL=

# GGUF files are run by llama.cpp. KOVAI finds a llama-server binary on PATH, in
# Homebrew, or among LM Studio's bundled Metal builds; set this for a specific one.
KOVAI_LLAMA_SERVER=

# Context window for a loaded GGUF, and how long an idle model stays resident
# before its memory is released.
KOVAI_GGUF_CTX=8192
KOVAI_GGUF_IDLE_TIMEOUT=900

# Load the default model at startup so the first message is not a cold start.
# Set to 0 to leave the memory free until a model is actually asked for.
KOVAI_PRELOAD=1

# Vision with a local GGUF needs the model's mmproj (projector) file. KOVAI pairs
# it from the models folder by name; set this to point at a specific one.
KOVAI_MMPROJ=

# Set to 0 to stop the interface from being able to start the runtime itself.
KOVAI_ALLOW_RUNTIME_SPAWN=1

# ── Persistence ──────────────────────────────────────────────
# Leave empty to use the built-in file store at .kovai/data.json
DATABASE_URL=
